# === Required ===

# Encryption key for credentials at rest (AES-256-GCM)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Turnstile verification for magic-link sign-in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# === Optional ===

# App URL
# APP_URL=https://agentkey.dev

# Explicit app environment; production enables fail-closed auth checks
# APP_ENV=development

# Number of trusted reverse proxies in front of the app. Used to pick the real
# client IP out of X-Forwarded-For for pre-auth rate limiting: the rightmost N
# entries are appended by infrastructure you trust, anything further left is
# client-supplied and forgeable. Defaults to 1 (Cloudflare). Set to 0 only if
# nothing proxies the app.
# TRUSTED_PROXY_COUNT=1

# Brandfetch API (tool logos in the catalog)
# NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=replace-with-brandfetch-client-id

# AI model for setup guide generation and form drafting
# Uses the Cloudflare Workers AI binding
# AI_DRAFT_MODEL=@cf/moonshotai/kimi-k2.6

# Magic-link sender address on an Email Service-onboarded domain
# AUTH_EMAIL_FROM=AgentKey <login@agentkey.dev>
